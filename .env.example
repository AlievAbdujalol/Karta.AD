# Supabase Configuration
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Supabase Service Role (for server-side operations, do not expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OSRM Configuration (optional - defaults to public server)
OSRM_URL=https://router.project-osrm.org

# Google Gemini (умный поиск; необязательно — без ключа работает обычный поиск)
# Взять: https://aistudio.google.com/apikey
# ВНИМАНИЕ: ключ во фронтенде виден в devtools — для продакшена проксируйте через Edge Function
VITE_GEMINI_API_KEY=your_gemini_key
# VITE_GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (AI-конструктор сайтов в Бизнесе; взять: https://openrouter.ai/keys)
# ВНИМАНИЕ: ключ во фронтенде виден в devtools — для продакшена проксируйте через Edge Function
VITE_OPENROUTER_API_KEY=

# Google Maps Platform (слои Google улиц/спутник/гибрид; уже используется приложением)
# Взять: https://console.cloud.google.com/google/maps-apis/
VITE_GOOGLE_MAPS_KEY=your_google_maps_key

# CARTO Basemaps (карта; бесплатно — взять: https://carto.com/basemaps/apikey/)
# Без ключа растровые тайлы CARTO отдают водяной знак "API KEY REQUIRED".
# Без ключа приложение автоматически использует OSM/Esri.
VITE_CARTO_API_KEY=your_carto_key

# Application Settings
VITE_APP_NAME=Karta-AD
VITE_DEFAULT_MAP_CENTER_LAT=38.559
VITE_DEFAULT_MAP_CENTER_LNG=68.773
VITE_DEFAULT_MAP_ZOOM=13

# Environment
NODE_ENV=development
