# ─── Karta-AD · пример окружения (.env.example) ─────────────────────────
# Локально: cp .env.example .env.local  (файл .env.local в .gitignore, не коммитить)
# Vercel:   Settings → Environment Variables — вставь те же значения оттуда же.
# В бандл попадают только VITE_* → publishable/публичные ключи, никаких секретов!

# ─── Обязательные (без них приложение не стартует) ──────────────────────
# Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# ─── Рекомендуемые для прода ────────────────────────────────────────────
# CARTO Basemaps — тайлы карты (бесплатно: https://carto.com/basemaps/apikey/)
# Без ключа растровые тайлы CARTO отдают водяной знак "API KEY REQUIRED",
# приложение автоматически уходит на OSM/Esri.
# Ключ виден в бандле → ограничь его доменами в панели CARTO.
# Если ключ когда-либо попадал в git-историю — считай скомпрометированным
# и выпусти новый (старый не удаляй, пока новый не проверен).
VITE_CARTO_API_KEY=your_carto_key

# Google Maps Platform — слои улица/спутник/гибрид
# https://console.cloud.google.com/google/maps-apis/
# Без ключа слои Google недоступны (остальные тайлы работают).
# Обязательно ограничь ключ HTTP-реферерами (только домены приложения)
# и включи только нужные API (Maps JavaScript API).
# Если ключ попадал в git-историю — выпусти новый в консоли Google.
VITE_GOOGLE_MAPS_KEY=your_google_maps_key

# ─── Опциональные: ИИ ───────────────────────────────────────────────────
# Google Gemini — умный поиск, чат, объяснение маршрутов.
# Ключ формата AQ.…: https://aistudio.google.com/apikey
# Взять лучше в профиле: Профиль → Мои AI-ключи (там ключ не в бандле).
# ВНИМАНИЕ: VITE_GEMINI_API_KEY виден в devtools — на проде НЕ клади сюда
# общий ключ: пусть каждый пользователь вводит свой в профиле.
# Если ключ попадал в git-историю — выпусти новый (Google AI Studio →
# API keys → Delete старого после проверки нового).
VITE_GEMINI_API_KEY=your_gemini_key
# Модель по умолчанию gemini-3.6-flash — раскомментируй только чтобы сменить.
# VITE_GEMINI_MODEL=gemini-3.6-flash

# OpenRouter — AI-конструктор сайтов (запасной прямой режим, когда
# Edge Function ai-proxy недоступна): https://openrouter.ai/keys
# ВНИМАНИЕ: ключ попадает в публичный бандл — ставь сознательно и включай
# лимиты расхода. Основной путь — секрет в Supabase (см. блок ниже).
VITE_OPENROUTER_API_KEY=

# ─── Секреты — ТОЛЬКО Supabase Edge Functions, НИКОГДА не Vercel/бандл ───
# Локально: supabase functions serve --env-file .env.local
# В проде:  supabase secrets set SUPABASE_SERVICE_ROLE_KEY=... OPENROUTER_API_KEY=...
# Эти переменные НЕ читаются фронтендом (без VITE_) — не добавляй их в Vercel.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# OPENROUTER_API_KEY=your_openrouter_key_for_ai_proxy
# PAYMENT_SECRET=your_payment_secret
