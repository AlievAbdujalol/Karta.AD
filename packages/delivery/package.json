{
  "name": "@karta-ad/delivery",
  "version": "1.0.0",
  "description": "Official Karta-AD Delivery SDK — connect any online shop to courier delivery in 5 minutes",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "karta-ad",
    "delivery",
    "courier",
    "taxi",
    "tajikistan",
    "sdk",
    "shop"
  ],
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/karta-ad/delivery"
  }
}
