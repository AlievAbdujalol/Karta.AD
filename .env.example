# Supabase Configuration
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Supabase Service Role (for server-side operations, do not expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OSRM Configuration (optional - defaults to public server)
OSRM_URL=https://router.project-osrm.org

# Google Gemini (умный поиск; необязательно — без ключа работает обычный поиск)
# Взять: https://aistudio.google.com/apikey
# ВНИМАНИЕ: ключ во фронтенде виден в devtools — для продакшена проксируйте через Edge Function
VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=gemini-2.0-flash

# Application Settings
VITE_APP_NAME=Karta-AD
VITE_DEFAULT_MAP_CENTER_LAT=38.559
VITE_DEFAULT_MAP_CENTER_LNG=68.773
VITE_DEFAULT_MAP_ZOOM=13

# Environment
NODE_ENV=development